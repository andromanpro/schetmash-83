{
  "name": "schetmash-83",
  "version": "0.4.1",
  "description": "Ретрофутуристический 3D-слот СЧЁТМАШ-83 с символами из мира 1С",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5274",
    "build": "vite build && node tools/production-check.mjs",
    "preview": "vite preview --port 4274",
    "test": "npm run test:math && npm run test:receipt && npm run test:render && npm run smoke-test",
    "test:math": "node tools/game-math-test.mjs",
    "test:receipt": "node tools/receipt-paper-test.mjs",
    "smoke-test": "node tools/smoke-test.mjs",
    "audit:runtime": "node tools/runtime-audit.mjs",
    "shot": "node tools/shot.mjs",
    "shot:receipt": "node tools/receipt-visual-check.mjs",
    "test:render": "node tools/static-batches-test.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.3.0",
    "vite": "^8.1.3"
  },
  "license": "MIT",
  "author": "Androman (https://androman.pro)",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andromanpro/schetmash-83.git"
  },
  "homepage": "https://andromanpro.github.io/schetmash-83/"
}
